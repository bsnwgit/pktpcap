#!/bin/bash
# /opt/pktpcap/pktpcap
# Wireshark SSH Remote Capture wrapper for pktPCAP.
# Must be enabled in pktPCAP Live Feeds > Wireshark tab before use.
#
# Wireshark SSH Remote Capture settings:
#   SSH Host:    <pktpcap-server-ip>
#   SSH User:    <ssh-user>
#   Auth:        Key file (<your-ssh-key.pem>)
#   Command:     /opt/pktpcap/pktpcap
#   Interface:   eth0

set -uo pipefail

DUMPCAP=/usr/bin/dumpcap

# Gate: check if Wireshark remote capture is enabled in pktPCAP
ENABLED=$(curl -sf http://localhost:__PORT__/api/settings \
    | python3 -c "import sys,json; print('1' if json.load(sys.stdin).get('wireshark_capture_enabled') else '0')" 2>/dev/null || echo "0")

if [ "$ENABLED" != "1" ]; then
    echo "pktPCAP: Wireshark remote capture is currently disabled." >&2
    echo "Enable it in pktPCAP Live Feeds > Wireshark tab, then retry." >&2
    exit 1
fi

# Build feed name from SSH client IP + timestamp
CLIENT_IP=$(echo "${SSH_CLIENT:-}" | awk '{print $1}' | tr '.' '-')
TS=$(date +%H%M%S)
FEED_NAME="ws-${CLIENT_IP:-unknown}-${TS}"

# Get feed token
TOKEN=$(curl -sf http://localhost:__PORT__/api/settings \
    | python3 -c "import sys,json; print(json.load(sys.stdin).get('feed_token',''))" 2>/dev/null || true)

if [ -z "$TOKEN" ]; then
    exec "$DUMPCAP" "$@"
fi

# Tee: stdout -> Wireshark via SSH, process sub -> pktPCAP feed
"$DUMPCAP" "$@" | tee >(
    curl -s -X POST \
        -H "Authorization: Bearer ${TOKEN}" \
        -H "Content-Type: application/octet-stream" \
        --data-binary @- \
        "http://localhost:__PORT__/api/feed/${FEED_NAME}" \
        >/dev/null 2>&1
)
