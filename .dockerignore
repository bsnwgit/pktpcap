# Git
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd

# Database files (never bake data into the image)
service/*.db
service/*.db-shm
service/*.db-wal

# Runtime config (generated by entrypoint)
service/config.json

# Secrets and certs
service/ssl/
service/certs/
ssl/
.env
*.env

# Capture data
service/screenshots/
service/pkt-capture/
service/storage/

# Dev/deploy scripts (not needed in image)
o2-*.py
o2-diagnose.py
git-setup-and-push.bat
deploy-to-apps.bat
backup.py
PROJECT_CONTEXT.md

# CI/CD config (not needed in image)
.github/

# Docs and assets
README.md
*.md
lockup-*.png
lockup.svg
icon*.png
icon.svg
favicon.ico
screenshots/
test-cap.pcapng
