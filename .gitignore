# Config (contains API keys — never commit)
service/config.json
config.yaml

# Virtual environments
venv/
.venv/

# Environment files
.env
.env.*
!.env.example

# Node / frontend build output
node_modules/
frontend/dist/
frontend/.vite/

# Local project notes — not for public repo
PROJECT_CONTEXT.md

# SSL certs and keys
service/ssl/
service/certs/
ssl/*.crt
ssl/*.key
ssl/*.pem
ssl/*.pfx

# Runtime output — anchored to the repo root, so it does not also swallow
# docs/screenshots/, which is committed on purpose.
/screenshots/

# Database (contains user accounts)
*.db
*.db-shm
*.db-wal

# Large test files
*.pcapng
*.pcap
*.cap

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Windows
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~
