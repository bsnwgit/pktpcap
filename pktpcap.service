# Template — install.sh substitutes __INSTALL_DIR__ / __LOG_DIR__ /
# __SERVICE_USER__ / __SERVICE_GROUP__ before installing to systemd.
# For a manual install, replace these placeholders yourself.
#
# Host/port are NOT set here — app/server.py reads them from config.yaml at
# each process start, so Settings -> General -> Port only needs config.yaml
# rewritten + a restart, not a unit file edit.
[Unit]
Description=pktPCAP Packet Capture Analyzer
Documentation=https://github.com/bsnwgit/pktpcap
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__

Environment=PKTPCAP_CONFIG=__INSTALL_DIR__/config.yaml
Environment=PKTPCAP_INSTALL_DIR=__INSTALL_DIR__

ExecStart=__INSTALL_DIR__/venv/bin/python -m app.server

# Default port is 8765 (unprivileged) — these capabilities are only needed
# if the admin sets Port to something below 1024 in Settings.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

StandardOutput=append:__LOG_DIR__/pktpcap.log
StandardError=append:__LOG_DIR__/pktpcap.log

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
