# ── pktPCAP environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.
# .env is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────
# Admin account created on first run (ignored if the database already has users)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
APP_ADMIN_EMAIL=

# ── Ports ─────────────────────────────────────────────────────────────────────
# Internal port the app listens on inside the container
APP_PORT=80

# External ports exposed on the host
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# ── Storage ───────────────────────────────────────────────────────────────────
# Path inside the container where PCAP uploads are stored
# Defaults to /storage (the pktpcap_storage named volume)
# APP_STORAGE_PATH=/storage
